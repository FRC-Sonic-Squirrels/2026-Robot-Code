# .gitattributes
# Handle line endings automatically for files detected as text
* text=auto eol=lf

# Force LF for shell scripts and gradlew
*.sh text eol=lf
gradlew text eol=lf

# Force LF for source code files (cross-platform compatibility)
*.cpp text eol=lf
*.h text eol=lf
*.java text eol=lf
*.gradle text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
